{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile", "watchPatterns": ["sales/backend/**", "sales/railway/scheduler.json"] },
  "deploy": {
    "startCommand": "celery -A app.worker beat --loglevel=INFO --schedule=/tmp/celerybeat-schedule",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
