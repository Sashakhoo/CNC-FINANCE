# Codencode Lead Intelligence (Sales CRM). Copy to .env for local overrides.
# Never commit real keys. Every provider below is optional: without it the
# app still runs and shows that provider as NOT CONFIGURED.

APP_ENV=development            # development | test | production
DEMO_MODE=false                # true = show only clearly-flagged fictional demo records
POSTGRES_PASSWORD=crm-dev-password
# DATABASE_URL / REDIS_URL are set by docker-compose; on Railway use the plugin URLs
# (DATABASE_URL must use the postgresql+asyncpg:// scheme).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL=redis://host:6379/0
# TEST_DATABASE_URL=postgresql+asyncpg://crm:crm-dev-password@postgres:5432/crm_test

# ── Sign-in (owned by CNC Finance) ──────────────────────────────────────
# Finance must have COOKIE_DOMAIN=.codencode.my in production so its session
# cookie reaches crm.codencode.my.
FINANCE_INTERNAL_URL=http://finance:8000          # Railway: https://finance.codencode.my
FINANCE_PUBLIC_URL=http://localhost:8081          # Railway: https://finance.codencode.my
# Same value on Finance and here. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRM_INTEGRATION_SECRET=
FRONTEND_URL=http://localhost:8080        # Railway: https://crm.codencode.my
# Other origins allowed to make writes (comma-separated). Railway: https://main.codencode.my
ALLOWED_ORIGINS=
# Per-provider quota overrides (JSON). Example: {"brave": {"minute": 30, "month": 2000}, "hunter": {"month": 500}}
PROVIDER_LIMITS=

# ── Providers ───────────────────────────────────────────────────────────
SEARCH_PROVIDER=               # brave | tavily
SEARCH_API_KEY=
EMAIL_DISCOVERY_PROVIDER=      # e.g. hunter
EMAIL_DISCOVERY_API_KEY=
EMAIL_VERIFICATION_PROVIDER=   # hunter | zerobounce
EMAIL_VERIFICATION_API_KEY=
LLM_PROVIDER=                  # gemini | anthropic | openai
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
