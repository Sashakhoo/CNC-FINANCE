# ── Telegram bot ────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Restrict who can use the bot — comma-separated Telegram numeric user IDs.
# Find yours by messaging @userinfobot. Leave blank only during testing.
ALLOWED_USER_IDS=

# Shared secret Telegram echoes back on every webhook call. Generate one
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# then it is sent as secret_token when you run `python main.py` to register
# the webhook. Without it, the /telegram/webhook endpoint accepts any POST.
TELEGRAM_WEBHOOK_SECRET=

# ── Gemini (receipt/text extraction) ───────────────────────────────────
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model names change often — check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-lite-latest

# ── Dashboard login ───────────────────────────────────────────────────
# LEAVE THIS BLANK. Accounts live in the database. On first run (empty
# users table) the dashboard shows a "create your account" screen — you
# pick your own username + password and become the director. Everything
# else is managed from the Team screen.
#
# DASH_USERS is optional and only pre-creates accounts on first boot
# instead of showing the setup screen — comma-separated
# username:password:role (password may be scrypt:<salt>:<hash> from
# `python hash_password.py`; no ':' or ',' in plaintext passwords).
DASH_USERS=

# Long random string — signs the session cookie. REQUIRED in production
# (without it every session drops on restart). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Optional: session lifetime in seconds (default 604800 = 7 days).
SESSION_MAX_AGE_SECONDS=604800

# ── LMS auto-enroll integration (learn.codencode.my) ───────────────────
# When an invoice is marked Paid or Deposit, Finance pushes it to the LMS
# so the student profile + course/workshop enrollment are created there
# automatically. Leave both blank to disable the sync (invoices still work
# fine — the invoice just gets an "LMS sync not configured" note).
LMS_SYNC_URL=https://learn.codencode.my
# Must match FINANCE_SYNC_SECRET set on the learn.codencode.my service.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LMS_SYNC_SECRET=

# ── Deploy ────────────────────────────────────────────────────────────
# Public URL of this service once deployed (used to register the Telegram webhook)
PUBLIC_URL=https://your-app.up.railway.app

# SQLite file path — on Railway, point this at a mounted volume so the
# ledger survives redeploys, e.g. /data/cnc.db
DB_PATH=./cnc.db
