# ── Telegram bot ────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Restrict who can use the bot — comma-separated Telegram numeric user IDs.
# Find yours by messaging @userinfobot. Leave blank only during testing.
ALLOWED_USER_IDS=

# ── Gemini (receipt/text extraction) ───────────────────────────────────
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model names change often — check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-lite-latest

# ── Dashboard login (users) ───────────────────────────────────────────
# Comma-separated  username:password:role  entries. Roles: director / admin
# / editor can edit; any other role (e.g. viewer) is read-only.
# Leave blank to use the built-in defaults in backend/auth.py.
DASH_USERS=sashakhoo:1688:director,admin:8888:admin
# Long random string — signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── Deploy ────────────────────────────────────────────────────────────
# Public URL of this service once deployed (used to register the Telegram webhook)
PUBLIC_URL=https://your-app.up.railway.app

# SQLite file path — on Railway, point this at a mounted volume so the
# ledger survives redeploys, e.g. /data/cnc.db
DB_PATH=./cnc.db
